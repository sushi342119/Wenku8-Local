# built application files
*.apk
*.ap_

# files for the dex VM
*.dex

# Java class files
*.class

# generated files
bin/
gen/

# Local configuration file (sdk path, etc)
local.properties

# Eclipse project files
.classpath
.project

# Proguard folder generated by Eclipse
proguard/

# Proguard files by Gradle
studio-android/LightNovelLibrary/app/*unused.txt
studio-android/LightNovelLibrary/app/*seeds.txt
studio-android/LightNovelLibrary/app/*mapping.txt
studio-android/LightNovelLibrary/app/*class_files.txt
studio-android/LightNovelLibrary/app/*mapping.txt
studio-android/LightNovelLibrary/app/*-report.txt


# Covers JetBrains IDEs: IntelliJ, RubyMine, PhpStorm, AppCode, PyCharm, CLion, Android Studio and Webstorm
# Reference: https://intellij-support.jetbrains.com/hc/en-us/articles/206544839

# User-specific stuff:
.idea/workspace.xml
.idea/tasks.xml
.idea/dictionaries
.idea/vcs.xml
.idea/jsLibraryMappings.xml

# Sensitive or high-churn files:
.idea/dataSources.ids
.idea/dataSources.xml
.idea/dataSources.local.xml
.idea/sqlDataSources.xml
.idea/dynamic.xml
.idea/uiDesigner.xml

# Gradle:
.idea/gradle.xml
.idea/libraries

# Mongo Explorer plugin:
.idea/mongoSettings.xml

## File-based project format:
*.iml
*.ipr
*.iws

## Plugin-specific files:

# IntelliJ
/out/

# mpeltonen/sbt-idea plugin
.idea_modules/

# JIRA plugin
atlassian-ide-plugin.xml

# Crashlytics plugin (for Android Studio and IntelliJ)
com_crashlytics_export_strings.xml
crashlytics.properties
crashlytics-build.properties
fabric.properties

# Flutter/Dart generated files
.idea/
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.metadata
.packages
.pub-cache/
.pub/
.fvm/flutter_sdk
/build/
/coverage/
/.local-samples/
/android/.gradle/
/ios/Pods/
/ios/Flutter/Generated.xcconfig
/ios/Flutter/flutter_export_environment.sh

# Local QA captures, personal device logs and internal development notes
.DS_Store
/.local-notes/
/flutter_screenshots/
/sites/
/FLUTTER_MIGRATION.md
/LISTENING.md
**/__pycache__/
*.pyc

# Machine paths and signing credentials
key.properties
*.keystore
*.jks

# Keep standalone diagnostics locally, outside the public app sources
/lib/performance_page.dart
/lib/ui_performance.dart
/lib/expansion_probe.dart
/lib/render_budget_probe.dart
/integration_test/performance_capture_test.dart
/test/ui_frame_capture_test.dart
/tools/*
!/tools/export_public_source.py
!/tools/test_public_source_export.py
!/tools/generate_app_icons.dart
!/tools/prepare_release.py
!/tools/test_prepare_release.py
!/tools/check_public_source.py
!/tools/test_public_source_policy.py
!/tools/verify_apk_runtime.py
!/tools/test_verify_apk_runtime.py
