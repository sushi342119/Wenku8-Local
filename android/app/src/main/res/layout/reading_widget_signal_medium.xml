                        </FrameLayout>
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="—" android:textSize="10sp" android:textColor="#5F6F69" android:includeFontPadding="false" android:fontFamily="sans-serif" android:maxLines="1" android:ellipsize="end" android:id="@+id/widget_day_3" android:gravity="center" android:layout_marginTop="2dp" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:orientation="vertical" android:layout_weight="1" android:gravity="bottom|center_horizontal">
                        <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
                            <ProgressBar android:id="@+id/widget_bar_4" android:layout_width="19dp" android:layout_height="5dp" android:rotation="-90" android:layout_gravity="center" android:progressDrawable="@drawable/reading_widget_progress_signal" android:max="100" android:progress="0" android:indeterminate="false" style="?android:attr/progressBarStyleHorizontal" />
                        </FrameLayout>
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="—" android:textSize="10sp" android:textColor="#5F6F69" android:includeFontPadding="false" android:fontFamily="sans-serif" android:maxLines="1" android:ellipsize="end" android:id="@+id/widget_day_4" android:gravity="center" android:layout_marginTop="2dp" />
                    </LinearLayout>
