                    <TextView android:layout_width="wrap_content" android:layout_height="match_parent" android:text="—" android:textSize="28sp" android:textColor="#1C292A" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:id="@+id/widget_value" android:gravity="bottom" style="@style/ReadingWidgetDisplayBold" />
