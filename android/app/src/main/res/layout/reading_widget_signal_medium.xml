<?xml version="1.0" encoding="utf-8"?>
<FrameLayout android:layout_width="match_parent" android:layout_height="match_parent" android:id="@+id/reading_widget_root" android:background="@drawable/reading_widget_surface_signal" android:clipToOutline="true" xmlns:android="http://schemas.android.com/apk/res/android">
