        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textSize="11sp" android:textColor="#18232C" android:includeFontPadding="false" android:fontFamily="sans-serif" android:maxLines="1" android:ellipsize="end" android:id="@+id/widget_totals" android:visibility="gone" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="15dp" android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:text="近13周" android:textSize="10sp" android:textColor="#5F6F69" android:includeFontPadding="false" android:fontFamily="sans-serif" android:maxLines="1" android:ellipsize="end" android:id="@+id/widget_heatmap_heading" android:layout_weight="1" />
